# Direct/local/mock development reference. Copy to an ignored local file and
# replace every operator value. Compose operators should instead copy
# .env.compose.example to .env next to their ignored docker-compose.yml.
NODE_ENV=development
ARCSUITE_ADAPTER_MODE=mock
ARCSUITE_MCP_BIND_HOST=127.0.0.1
ARCSUITE_MCP_PORT=8080
MCP_SCOPES_FILE=config/scopes.mock.yaml
MCP_DEV_BEARER_TOKEN=change-this-local-token
MCP_MAX_REQUEST_BYTES=1048576
MCP_SEARCH_DEFAULT_LIMIT=20
MCP_SEARCH_MAX_LIMIT=50
MCP_BATCH_MAX_IDS=50
MCP_READ_DEFAULT_MAX_CHARS=20000
MCP_READ_MAX_CHARS=50000
MCP_MAX_CONTENT_BYTES=52428800
MCP_MAX_EXTRACTED_CHARS=200000

# v1.1 bounded paging snapshot cache.
MCP_PAGING_TTL_SECONDS=600
MCP_PAGING_SNAPSHOT_MAX_IDS=1000
MCP_PAGING_MAX_SNAPSHOTS=100
MCP_PAGING_MAX_SNAPSHOTS_PER_CLIENT=10
MCP_PAGING_MAX_TOTAL_IDS=10000

# v1.1 extracted-content snapshot cache. This cache is process-local and
# contains normalized text only; it never changes ArcSuite authority.
MCP_CONTENT_CACHE_TTL_SECONDS=600
MCP_CONTENT_CACHE_MAX_ENTRIES=64
MCP_CONTENT_CACHE_MAX_ENTRIES_PER_CLIENT=16
MCP_CONTENT_CACHE_MAX_BYTES=16777216

# Required for ARCSUITE_ADAPTER_MODE=http. These are examples only. The
# /run/secrets paths require equivalent mounts; direct local runs may override
# them with protected local paths or the documented non-production fallbacks.
ARCSUITE_ADAPTER_BASE_URL=http://127.0.0.1:18080
ARCSUITE_ADAPTER_INTERNAL_TOKEN_FILE=/run/secrets/arcsuite_adapter_internal_token
# ARCSUITE_ADAPTER_INTERNAL_TOKEN=local-development-only-token

# Required for production deployments. Prefer files or a secret manager.
# The same HMAC secret protects both content cursors and paging cursors.
MCP_CURSOR_HMAC_SECRET_FILE=/run/secrets/arcsuite_cursor_hmac_secret
# MCP_CURSOR_HMAC_SECRET=local-development-only-cursor-secret
MCP_CURSOR_TTL_SECONDS=600
ARCSUITE_MCP_CLIENT_TOKENS_JSON_FILE=/run/secrets/arcsuite_client_tokens.json
MCP_VALIDATE_ON_STARTUP=true

# Java adapter settings. The real endpoint and credentials belong only in the
# operator's environment. The ArcSuite challenge supplies the RSA public key;
# the adapter reads the password from the mounted secret file.
ARCSUITE_SOAP_ENDPOINT=https://arcsuite.example.invalid/ArcSuite/2021/04/ws
ARCSUITE_USERNAME=operator-supplied
ARCSUITE_PASSWORD_FILE=/run/secrets/arcsuite_password
ARCSUITE_ALLOW_HTTP=false
ARCSUITE_ADAPTER_BIND_HOST=127.0.0.1
ARCSUITE_ADAPTER_PORT=18080
ARCSUITE_MAX_CONTENT_BYTES=52428800
