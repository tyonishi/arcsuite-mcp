# Copy to a local, ignored environment file and replace every operator value.
NODE_ENV=development
ARCSUITE_ADAPTER_MODE=mock
ARCSUITE_MCP_BIND_HOST=127.0.0.1
ARCSUITE_MCP_PORT=8080
MCP_SCOPES_FILE=config/scopes.mock.yaml
MCP_DEV_BEARER_TOKEN=change-this-local-token
MCP_MAX_REQUEST_BYTES=1048576

# Required for ARCSUITE_ADAPTER_MODE=http. These are examples only.
ARCSUITE_ADAPTER_BASE_URL=http://127.0.0.1:18080
ARCSUITE_ADAPTER_INTERNAL_TOKEN_FILE=/run/secrets/arcsuite_adapter_internal_token
# ARCSUITE_ADAPTER_INTERNAL_TOKEN=local-development-only-token

# Required for production deployments. Prefer files or a secret manager.
MCP_CURSOR_HMAC_SECRET_FILE=/run/secrets/arcsuite_cursor_hmac_secret
# MCP_CURSOR_HMAC_SECRET=local-development-only-cursor-secret
ARCSUITE_MCP_CLIENT_TOKENS_JSON_FILE=/run/secrets/arcsuite_client_tokens.json
MCP_VALIDATE_ON_STARTUP=true

# Java adapter settings. The real endpoint and credentials belong only in the
# operator's environment. The ArcSuite challenge supplies the RSA public key;
# the adapter reads the password from the mounted secret file.
ARCSUITE_SOAP_ENDPOINT=https://arcsuite.example.invalid/ArcSuite/2021/04/ws
ARCSUITE_USERNAME=operator-supplied
ARCSUITE_PASSWORD_FILE=/run/secrets/arcsuite_password
ARCSUITE_ALLOW_HTTP=false
ARCSUITE_ADAPTER_BIND_HOST=127.0.0.1
ARCSUITE_ADAPTER_PORT=18080
ARCSUITE_MAX_CONTENT_BYTES=52428800
