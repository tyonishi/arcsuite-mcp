# Public companion for docker-compose.example.yml.
# Copy to the ignored .env and replace operator values. This file intentionally
# contains no passwords, bearer tokens, HMAC keys, or adapter tokens; those
# remain in local-secrets/ and are mounted through Compose secrets.

IMAGE_TAG=local
ARCSUITE_MCP_SOURCE_REVISION=unknown
ARCSUITE_MCP_BIND_IP=127.0.0.1
ARCSUITE_MCP_HOST_PORT=8080
MCP_AUDIT_LOG_PATH=/tmp/arcsuite-mcp-audit.jsonl
MCP_VALIDATE_ON_STARTUP=true
MCP_ALLOWED_HOSTNAMES=localhost,127.0.0.1
MCP_ALLOWED_ORIGIN_HOSTNAMES=localhost,127.0.0.1

MCP_SEARCH_DEFAULT_LIMIT=20
MCP_SEARCH_MAX_LIMIT=50
MCP_HARD_REFERENCE_MAX_CANDIDATES=200
MCP_BATCH_MAX_IDS=50
MCP_READ_DEFAULT_MAX_CHARS=20000
MCP_READ_MAX_CHARS=50000
MCP_MAX_REQUEST_BYTES=1048576
MCP_MAX_CONTENT_BYTES=52428800
MCP_MAX_EXTRACTED_CHARS=200000
MCP_CURSOR_TTL_SECONDS=600

MCP_PAGING_TTL_SECONDS=600
MCP_PAGING_SNAPSHOT_MAX_IDS=1000
MCP_PAGING_MAX_SNAPSHOTS=100
MCP_PAGING_MAX_SNAPSHOTS_PER_CLIENT=10
MCP_PAGING_MAX_TOTAL_IDS=10000
# MCP_PAGING_MAX_TOTAL_IDS_PER_CLIENT is intentionally omitted so the runtime
# derives its bounded default from the global and per-snapshot limits. To
# override it, add an explicit environment mapping to the ignored local
# docker-compose.yml and validate the value against the global bound.

MCP_CONTENT_CACHE_TTL_SECONDS=600
MCP_CONTENT_CACHE_MAX_ENTRIES=64
MCP_CONTENT_CACHE_MAX_ENTRIES_PER_CLIENT=16
MCP_CONTENT_CACHE_MAX_BYTES=16777216

ARCSUITE_SOAP_ENDPOINT=https://arcsuite.example.invalid/ArcSuite/2021/04/ws
ARCSUITE_USERNAME=operator-supplied
ARCSUITE_ALLOW_HTTP=false
ARCSUITE_CONNECT_TIMEOUT_MS=30000
ARCSUITE_REQUEST_TIMEOUT_MS=600000
ARCSUITE_SESSION_IDLE_TTL_SECONDS=1500
ARCSUITE_SESSION_MAX_AGE_SECONDS=1700
ARCSUITE_PER_SESSION_CONCURRENCY=4
ARCSUITE_LOCALE=ja
ARCSUITE_REQUEST_VERSION=4.0.0.0
ARCSUITE_MAX_CONTENT_BYTES=52428800
