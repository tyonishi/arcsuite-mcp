FROM eclipse-temurin:22.0.2_9-jdk-jammy@sha256:d8e6ba486df17bf758888d2b1b608133d1eedca8daf69d3fc6bf78d8be81e07e AS build
WORKDIR /src
COPY . .
RUN ./compile.sh

FROM eclipse-temurin:22.0.2_9-jre-jammy@sha256:dbcae8b5dd4d63f81739a538ec2c09797735f04a21d814f9071b62f018326043
WORKDIR /app
COPY --from=build /src/build/classes /app/classes
RUN install -d -m 700 /shared && chown -R 10001:0 /app /shared
USER 10001
# The adapter port is reachable only on the private container network. The
# non-container default remains loopback in AdapterConfig.java.
ENV ARCSUITE_ADAPTER_BIND_HOST=0.0.0.0 ARCSUITE_ADAPTER_PORT=18080 MCP_TEMP_DIR=/shared
CMD ["java", "-cp", "/app/classes", "biz.capricornus.arcsuite.mcp.adapter.Main"]
